</span><span>  "description": "Online medical consultations with a physician, physiotherapist and dietitian every day after 5 PM via WhatsApp or Google Meet.",
</span><span>  "email": "rehabrecoverhealth@gmail.com",
</span><span>  "sameAs": ["https://www.instagram.com/rehab_recover_health"],
</span><span>  "openingHoursSpecification": {
