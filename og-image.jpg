</span><span>      "offers": {
</span><span>        "@type": "Offer",
</span><span>        "price": "300",
</span><span>        "priceCurrency": "INR"
</span><span>      }
</span><span>    },
</span><span>    {
</span><span>      "@type": "MedicalTherapy",
</span><span>      "name": "Online Dietitian Consultation",
</span><span>      "description": "Personalized diet and nutrition planning for diabetes, weight management and lifestyle goals with Dr Roshani Tank.",
</span><span>      "offers": {
</span><span>        "@type": "Offer",
</span><span>        "price": "300",
</span><span>        "priceCurrency": "INR"
</span><span>      }
</span><span>    }
</span><span>  ],
</span><span>  "staff": [
</span><span>    {
</span><span>      "@type": "Physician",
</span><span>      "name": "Dr Savan Kukadia",
</span><span>      "description": "MBBS, MD — Consultant Physician with 5+ years clinical experience in chronic disease, diabetes, hypertension and thyroid management.",
</span><span>      "identifier": "G 74451"
</span><span>    },
</span><span>    {
</span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span>      "@type": "Person",
</span><span>      "name": "Dr Roshani Tank",
</span><span>      "description": "MPT — Physiotherapist and Dietitian with 3+ years clinical experience in rehabilitation and nutrition.",
</span><span>      "identifier": "GPC 17106"
</span><span>    }
</span><span>  ]
</span><span>}
</span><span><span style="color: rgb(43, 48, 59);">&lt;/</span><span style="color: rgb(184, 10, 24);">script</span><span style="color: rgb(43, 48, 59);">&gt;</span>
</span><span>
</span><span><span style="color: rgb(110, 118, 135);">&lt;!-- Schema.org: FAQ Page --&gt;</span>
</span><span><span style="color: rgb(43, 48, 59);">&lt;</span><span style="color: rgb(184, 10, 24);">script</span> <span style="color: rgb(189, 15, 30);">type</span><span style="color: rgb(43, 48, 59);">=</span><span style="color: rgb(0, 128, 0);">"application/ld+json"</span><span style="color: rgb(43, 48, 59);">&gt;</span>
</span><span>{
</span><span>  "@context": "https://schema.org",
</span><span>  "@type": "FAQPage",
</span><span>  "mainEntity": [
</span><span>    {
</span><span>      "@type": "Question",
</span><span>      "name": "Is an online consultation as good as visiting a clinic?",
</span><span>      "acceptedAnswer": {
</span><span>        "@type": "Answer",
</span><span>        "text": "For many needs — follow-ups, chronic disease review, diet planning and guided physiotherapy exercises — an online consultation works very well. Some problems need physical examination or urgent care; we will guide you to local care if that is the case."
</span><span>      }
</span><span>    },
</span><span>    {
</span><span>      "@type": "Question",
</span><span>      "name": "How much does an online doctor consultation cost?",
</span><span>      "acceptedAnswer": {
</span><span>        "@type": "Answer",
</span><span>        "text": "Doctor, physiotherapy and dietitian consultations are ₹300 each. A package of 4 dietitian consultations is ₹1,000 (saving ₹200)."
</span><span>      }
</span><span>    },
</span><span>    {
</span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span>      "@type": "Question",
</span><span>      "name": "When can I book an online consultation?",
</span><span>      "acceptedAnswer": {
</span><span>        "@type": "Answer",
</span><span>        "text": "Consultations are available every day after 5:00 PM IST, including weekends, via WhatsApp or Google Meet."
</span><span>      }
</span><span>    },
</span><span>    {
</span><span>      "@type": "Question",
</span><span>      "name": "How do I pay for an online consultation?",
</span><span>      "acceptedAnswer": {
</span><span>        "@type": "Answer",
</span><span>        "text": "Payment is ₹300 per consultation. The payment QR code and UPI details are provided inside the consultation form. Pay by UPI (Google Pay, PhonePe or any UPI app), then submit the form to confirm your slot."
</span><span>      }
</span><span>    },
</span><span>    {
</span><span>      "@type": "Question",
</span><span>      "name": "What do I need for an online consultation?",
</span><span>      "acceptedAnswer": {
</span><span>        "@type": "Answer",
</span><span>        "text": "A smartphone or computer with video and internet connection, and a quiet space. For physiotherapy, enough room to move is helpful. Family members are welcome to join."
</span><span>      }
</span><span>    },
</span><span>    {
</span><span>      "@type": "Question",
</span><span>      "name": "Will I get a prescription or diet plan online?",
</span><span>      "acceptedAnswer": {
</span><span>        "@type": "Answer",
</span><span>        "text": "Yes, when clinically appropriate. After your consultation you receive your prescription, diet plan, or physiotherapy and rehabilitation program as applicable."
</span><span>      }
</span><span>    },
</span><span>    {
</span></span><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span>      "@type": "Question",
</span><span>      "name": "Who are the doctors at Rehabilitation Recover Health?",
</span><span>      "acceptedAnswer": {
</span><span>        "@type": "Answer",
</span><span>        "text": "Dr Savan Kukadia (MBBS, MD) is a Consultant Physician with 5+ years experience. Dr Roshani Tank (MPT) is a Physiotherapist and Dietitian with 3+ years experience."
</span><span>      }
</span><span>    }
</span><span>  ]
</span><span>}
</span><span><span style="color: rgb(43, 48, 59);">&lt;/</span><span style="color: rgb(184, 10, 24);">script</span><span style="color: rgb(43, 48, 59);">&gt;</span>
</span><span>
</span><span><span style="color: rgb(110, 118, 135);">&lt;!-- Schema.org: Website --&gt;</span>
</span><span><span style="color: rgb(43, 48, 59);">&lt;</span><span style="color: rgb(184, 10, 24);">script</span> <span style="color: rgb(189, 15, 30);">type</span><span style="color: rgb(43, 48, 59);">=</span><span style="color: rgb(0, 128, 0);">"application/ld+json"</span><span style="color: rgb(43, 48, 59);">&gt;</span>
</span><span>{
</span><span>  "@context": "https://schema.org",
</span><span>  "@type": "WebSite",
</span><span>  "name": "Rehabilitation Recover Health",
</span><span>  "url": "https://rrhclinic.in",
</span><span>  "potentialAction": {
</span><span>    "@type": "SearchAction",
</span><span>    "target": "https://rrhclinic.in/?q={search_term_string}",
</span><span>    "query-input": "required name=search_term_string"
</span><span>  }
</span><span>}
</span><span><span style="color: rgb(43, 48, 59);">&lt;/</span><span style="color: rgb(184, 10, 24);">script</span><span style="color: rgb(43, 48, 59);">&gt;</span>
</span><span>
</span><span><span style="color: rgb(43, 48, 59);">&lt;</span><span style="color: rgb(184, 10, 24);">style</span><span style="color: rgb(43, 48, 59);">&gt;</span>
</span><span><span style="color: rgb(110, 118, 135);">/* ... all your existing CSS unchanged ... */</span>
</span><span><span style="color: rgb(43, 48, 59);">&lt;/</span><span style="color: rgb(184, 10, 24);">style</span><span style="color: rgb(43, 48, 59);">&gt;</span>
</span><span><span style="color: rgb(43, 48, 59);">&lt;/</span><span style="color: rgb(184, 10, 24);">head</span><span style="color: rgb(43, 48, 59);">&gt;</span></span></span></code></pre></div></div></div>
<hr>
<h3 dir="ltr" aria-level="4">Two more things to do manually</h3>
<p dir="ltr"><strong>1. Create <code dir="ltr">llms.txt</code></strong> — upload this file at <code dir="ltr">rrhclinic.in/llms.txt</code>:</p>
<div data-not-prose=""><div role="group" aria-label="Code" tabindex="0" dir="ltr" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-100"><div class="sticky opacity-0 group-hover/copy:opacity-100 group-focus-within/copy:opacity-100 pointer-coarse:opacity-100 [@media(hover:none)]:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal font-control aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 rounded-[calc(var(--cds-radius)+var(--cds-button-radius-add,0px))] stacks:[&amp;:disabled:not([aria-busy])]:opacity-100 stacks:[&amp;:disabled:not([aria-busy])]:text-button-disabled stacks:[&amp;:disabled:not([aria-busy])]:[--cds-shortcut-cap-ink:currentColor] stacks:[&amp;:disabled:not([aria-busy])]:not-in-data-[cds=SplitDropdownButton]:[--cds-text-button-disabled:var(--cds-fizzy-lake-color-icon-only-disabled)] group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md pointer-coarse:backdrop-blur-md [@media(hover:none)]:backdrop-blur-md" aria-label="Copy to clipboard" data-testid="code-block-copy" id="_r_19s_" data-base-ui-tooltip-trigger="" fdprocessedid="cp8cen"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-